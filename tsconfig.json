{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@motoai/core": ["./packages/core/src"],
      "@motoai/core/*": ["./packages/core/src/*"],
      "@motoai/agent": ["./packages/agent/src"],
      "@motoai/agent/*": ["./packages/agent/src/*"],
      "@motoai/channel": ["./packages/channel/src"],
      "@motoai/channel/*": ["./packages/channel/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
