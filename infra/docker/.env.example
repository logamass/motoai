# ============================================
# MotoAI — Environment Variables
# Copy this to .env.prod and fill in real values
# ============================================

# --- Database ---
DATABASE_URL=postgres://motoai:CHANGE_ME@db:5432/motoai

# --- Auth (Auth.js) ---
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp (Meta Cloud API) --- Phase 4
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Storage (Cloudflare R2) --- Phase 2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=motoai

# --- Feature Flags ---
FLAG_ANALYTICS=false
FLAG_TELEGRAM=false
FLAG_VOICE=false
FLAG_EMI_BANKS=false
FLAG_MULTI_CITY=false

# --- Deploy ---
DOMAIN=your-domain.com
APP_VERSION=latest
GITHUB_REPO=your-org/motoai
